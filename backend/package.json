{
  "name": "medicalsys-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de MedicalSys",
  "main": "src/server.js",
  "scripts": {
    "security:seed": "node scripts/seed-security.js",
    "test:security": "node --test tests/security.test.js",
    "test:billing": "node --test tests/billing-query.test.js",
    "test:notifications": "node --test tests/notification-history.test.js",
    "test:whatsapp-incoming": "node --test tests/green-api-incoming.test.js",
    "test:campaign-loyalty": "node --test tests/campaign-loyalty.test.js",
    "test:architecture": "node --test tests/architecture.test.js",
    "test": "node --test tests/architecture.test.js tests/campaign-loyalty.test.js tests/billing-query.test.js tests/notification-history.test.js tests/green-api-incoming.test.js tests/security.test.js",
    "security:setup": "node scripts/setup-security.js",
    "security:grant-notifications": "node scripts/grant-notifications-permission.js",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:baseline": "prisma migrate resolve --applied 20260824_init_medicalsys",
    "prisma:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.0.0"
  }
}
