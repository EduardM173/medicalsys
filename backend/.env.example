# R2_ACCESS_KEY_ID="tu-access-key-id"
# R2_SECRET_ACCESS_KEY="tu-secret-access-key"
# R2_BUCKET_NAME="medicalsys-clinical-docs"
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
