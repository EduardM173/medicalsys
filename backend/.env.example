DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/medicalsys?schema=public"
PORT=3000
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="8h"

# Almacenamiento de Archivos (Opcional - por defecto usa LOCAL en uploads/)
STORAGE_PROVIDER="LOCAL"
