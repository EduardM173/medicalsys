# =====================================================================
# MedicalSys - Configuración de entorno (ejemplo)
# Copie este archivo como .env y ajuste los valores locales.
# =====================================================================

# --- Base de datos PostgreSQL -------------------------------------------------
# Use sslmode=require en producción (el backend lo fuerza si NODE_ENV=production).
DATABASE_URL="postgresql://postgres:TU_CONTRASENA@localhost:5432/medicalsys_test?sslmode=prefer"
NODE_ENV="development"
PORT=3000

# --- Sesión y CORS --------------------------------------------------------------
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="cambia-esta-clave-por-una-frase-larga-local"
JWT_EXPIRES_IN="8h"

# --- HU-31: Cifrado de datos clínicos (PA-01 a PA-09) --------------------------
# Claves AES-256 (32 bytes / 64 caracteres hex). JSON indexado por versión.
# En producción rote agregando "v2" y cambiando CURRENT_KEY_VERSION.
# ⚠️ Las siguientes claves son SOLO EJEMPLO: reemplácelas con claves reales.
ENCRYPTION_KEYS='{"v1":"3a9f8b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a"}'
CURRENT_KEY_VERSION="v1"
# Secreto HMAC-SHA256 para índices ciegos (búsquedas exactas sin descifrar).
BLIND_INDEX_SECRET="f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7"

# --- Almacenamiento de documentos clínicos (opcional: R2) ----------------------
STORAGE_PROVIDER="LOCAL"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_ENDPOINT=""

# --- WhatsApp / Green API (opcional) -------------------------------------------
# WHATSAPP_PROVIDER=GREEN_API
# GREENAPI_API_URL="https://xxxx.api.greenapi.com"
# GREENAPI_ID_INSTANCE="su_id_de_instancia"
# GREENAPI_API_TOKEN_INSTANCE="su_token_secreto"

APP_BASE_URL="http://localhost:5173"